{
	"name": "whatsapp-sdk-js",
	"version": "0.1.0-alpha.4",
	"description": "SDK for interfacing with WhatsApp Business Platform in Typescript or Node.js using the Cloud API, hosted by Meta.",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"bin": {
		"whatsapp-sdk": "build/cli.js"
	},
	"exports": {
		".": {
			"import": {
				"types": "./types/index.d.mts",
				"default": "./build/index.js"
			},
			"require": {
				"types": "./build/index.d.ts",
				"default": "./build/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"build",
		"src",
		"types"
	],
	"type": "commonjs",
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"start": "ts-node ./src/WhatsApp.ts",
		"build": "node ./scripts/create_version_file.mjs && rimraf ./build && tsc -p tsconfig.json && babel build --out-dir build && rimraf ./build/__tests__/ && node -e \"require('node:fs').chmodSync('build/cli.js', 0o755)\"",
		"check-changelog": "node ./scripts/check_changelog.mjs",
		"check-copyright-headers": "node ./scripts/check_copyright_headers.mjs",
		"create-version-file": "node ./scripts/create_version_file.mjs",
		"test": "yarn build && yarn test:typecheck && yarn test:jest && yarn test:lint && yarn test:prettier && yarn test:spelling",
		"test:spelling": "cspell \"{README.md,.github/*.md,website/docs/**/*.md}\"",
		"test:prettier": "prettier . --check",
		"test:lint": "eslint .",
		"test:jest": "jest",
		"test:typecheck": "tsc --noEmit",
		"test:package": "node ./scripts/check_package.mjs",
		"prettier-format": "prettier . --write",
		"prettier-watch": "onchange \"src/**/*.ts\" \"scripts/*.mjs\" -- prettier --write {{changed}}"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Izurii/WhatsApp-SDK.git"
	},
	"keywords": [
		"WhatsApp",
		"SDK",
		"Business",
		"Platform",
		"secure",
		"messaging",
		"NodeJS",
		"Cloud API"
	],
	"author": "Rashed Talukder",
	"license": "SEE LICENSE IN LICENSE FILE",
	"bugs": {
		"url": "https://github.com/Izurii/WhatsApp-SDK/issues"
	},
	"homepage": "https://izurii.github.io/WhatsApp-SDK/",
	"dependencies": {
		"@types/node": "^22.20.4"
	},
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.7",
		"@babel/plugin-transform-dynamic-import": "^7.29.7",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@jest/globals": "^30.5.2",
		"@types/jest": "^30.0.0",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"babel-jest": "^30.5.2",
		"babel-plugin-add-module-exports": "^1.0.4",
		"cspell": "^10.3.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.16.6",
		"globals": "^17.12.0",
		"graceful-fs": "^4.2.11",
		"isbinaryfile": "^6.0.0",
		"jest": "^30.5.2",
		"nock": "^14.0.17",
		"onchange": "^7.1.0",
		"prettier": "^3.9.8",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"ts-node": "^10.9.2",
		"typescript": "~6.0.3"
	}
}
